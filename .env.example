# Copia este archivo como .env.local y completa los valores. .env.local no se sube al repo.
#
# Desarrollo local (Supabase CLI + Docker): `npx supabase status` muestra la URL de la API
# y la clave publicable del entorno local.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu-clave-publicable

# En el cliente solo va la clave publicable (sb_publishable_…). La clave secreta
# (sb_secret_… o service_role) nunca va aquí ni en el repo: solo existe como secreto de
# las Edge Functions.

# Notificaciones push (RF-31). No las escribas a mano: `npm run vapid:claves` las agrega a
# .env.local sin imprimirlas. Solo VAPID_SUBJECT se escribe (el mailto: del equipo). Las de
# «staging» las genera una sola persona: otra clave invalidaría las suscripciones.
# VITE_VAPID_PUBLIC_KEY=clave-publica-vapid
# VAPID_PUBLIC_KEY=clave-publica-vapid
# VAPID_PRIVATE_KEY=nunca-en-el-repositorio
# VAPID_SUBJECT=mailto:equipo@ejemplo.com
# ENVIAR_PUSH_SECRETO=nunca-en-el-repositorio
