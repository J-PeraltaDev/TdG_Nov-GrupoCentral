{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc", "jsx-a11y"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "dist",
    "dev-dist",
    "docs/fuentes",
    "supabase/.temp",
    "src/core/supabase/database.types.ts"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "overrides": [
    {
      "files": ["src/sw.js"],
      "env": {
        "serviceworker": true,
        "browser": false
      }
    },
    {
      "files": ["*.config.js", "e2e/**"],
      "env": {
        "node": true
      }
    }
  ]
}
